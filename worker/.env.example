# Copy to worker/.env (git-ignored) and fill in. Never commit the real file.

# CallRail API key (CallRail > Settings > API Keys). Sent only to *.callrail.com.
CALLRAIL_API_KEY=

# The Apps Script web app /exec URL (https).
WEBHOOK_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec

# Must equal the API_SECRET script property in Apps Script.
API_SECRET=

# Optional overrides
# WHISPER_MODEL=mlx-community/whisper-large-v3-turbo
# LLM_MODEL=mlx-community/Qwen2.5-7B-Instruct-4bit
# BATCH_LIMIT=50
